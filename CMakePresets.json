{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Windows x64 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "/O2 /Ob2 /DNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "/O2 /Ob2 /DNDEBUG",
        "CMAKE_SHARED_LINKER_FLAGS_RELWITHDEBINFO": "/DEBUG /INCREMENTAL:NO /OPT:REF /OPT:ICF",
        "CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO": "/DEBUG /INCREMENTAL:NO /OPT:REF /OPT:ICF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "dev",
      "displayName": "Windows x64 Release with the diagnostic log and the development tools",
      "inherits": "release",
      "cacheVariables": {
        "PHANTOM_FX_DIAGNOSTIC_LOG": true,
        "PHANTOM_FX_DEV_TOOLS": true,
        "PHANTOM_DEV_SHADERS": true
      }
    },
    {
      "name": "tools",
      "displayName": "Windows x64 Release with the development tools, leaving the game's frame as it is",
      "inherits": "dev",
      "cacheVariables": {
        "PHANTOM_FX_TOOLS_ONLY": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "tools",
      "configurePreset": "tools"
    }
  ]
}
